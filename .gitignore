# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/
.venv/

# Environment files (must never be committed — SQL creds live here)
.env
.env.local
.env.*.local

# DPAPI-encrypted credential blob used by weekly-refresh.ps1.
# File is encrypted to the current Windows user + machine, so it's useless
# anywhere else, but no reason to publish it either.
.sql-cred.xml

# Local log from weekly-refresh.ps1
refresh.log
refresh.log.1

# Local Claude Code session config (weekly refresh pushes with `git add -A`)
.claude/

# Editors / IDEs
.vscode/
.idea/
*.swp

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Schema-discovery sidecars (errors per failed CSV)
b.schema/output/*.error.txt

# Local-only easter eggs / experiments. The weekly refresh pushes with
# `git add -A`, so anything meant to stay off the live site must be ignored.
*.local.js

# Census/TIGER response cache used by the shadow-market batch generator
shadow_market/.cache/

# Census Gazetteer cache used by the student-migration generator
student_migration/.cache/

# Raw student migration export stays outside the public repository
/MigrationOnly.csv
/MigrationOnly.xlsx

# IPEDS download cache for build_admissions_repository.py
_ipeds_cache/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
!.env.example
