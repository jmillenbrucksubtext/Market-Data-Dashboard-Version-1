# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/
.venv/

# Environment files (must never be committed — SQL creds live here)
.env
.env.local
.env.*.local

# DPAPI-encrypted credential blob used by weekly-refresh.ps1.
# File is encrypted to the current Windows user + machine, so it's useless
# anywhere else, but no reason to publish it either.
.sql-cred.xml

# Local log from weekly-refresh.ps1
refresh.log
refresh.log.1

# Editors / IDEs
.vscode/
.idea/
*.swp

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Schema-discovery sidecars (errors per failed CSV)
b.schema/output/*.error.txt
